{
  "schema_version": "1.0",
  "backend": "python-docx-ooxml",
  "capabilities": [
    {
      "id": "text-role-formatting",
      "role_pattern": "^(thesis_title_(zh|en)|heading_[1-9]|heading_(appendix|conclusion|references|acknowledgments|publications)|body_text|figure_caption|table_caption|table_text|abstract_title_(zh|en)|abstract_body_(zh|en)|keywords_(zh|en)|bibliography_heading|bibliography_entry|equation|footnote|header|footer|toc|toc_title|cover_field_(label|value)|thesis_(type_zh|type_en|author|author_en|affiliation_date|classified_index))$",
      "property_patterns": ["font.*", "paragraph.*", "numbering.*", "position", "prefix", "separator", "style_hint", "text", "header_content.*", "bottom_border.*"],
      "disposition": "supported"
    },
    {
      "id": "page-layout",
      "role_pattern": "^page$",
      "property_patterns": ["size", "orientation", "margins_pt.*", "different_first_page", "different_odd_even", "page_number.*", "font.*", "paragraph.*"],
      "disposition": "supported"
    },
    {
      "id": "table-layout",
      "role_pattern": "^(table|tables)$",
      "property_patterns": ["style", "top_border_pt", "header_border_pt", "bottom_border_pt", "remove_vertical_borders", "repeat_header_row", "allow_row_split", "keep_with_caption", "border_widths_pt.*", "continuation.*"],
      "disposition": "supported"
    },
    {
      "id": "equation-layout",
      "role_pattern": "^equations$",
      "property_patterns": ["alignment", "number_alignment", "number_parentheses", "same_line", "no_lines", "center_tab_twips", "right_tab_twips"],
      "disposition": "supported"
    },
    {
      "id": "object-pagination",
      "role_pattern": "^objects$",
      "property_patterns": ["keep_figure_with_caption", "keep_table_with_caption", "order_constraints.*"],
      "disposition": "supported"
    },
    {
      "id": "semantic-content-review",
      "role_pattern": "^content_constraints$",
      "property_patterns": [
        "abstract_zh.require_third_person",
        "abstract_zh.required_sections",
        "abstract_zh.prohibit_comments",
        "abstract_zh.prohibited_objects",
        "abstract_zh.exception_policy",
        "abstract_en.target"
      ],
      "disposition": "unknown",
      "message": "requires semantic or manual verification; deterministic formatting alone cannot prove this property"
    },
    {
      "id": "content-and-structure-contracts",
      "role_pattern": "^(content_constraints|conditional_constraints|document_structure|appendices|cover|declarations)$",
      "property_patterns": [
        "abstract_zh.required",
        "abstract_zh.min_chars",
        "abstract_zh.max_chars",
        "abstract_zh.length_metric",
        "abstract_en.required",
        "abstract_en.min_words",
        "abstract_en.max_words",
        "abstract_en.length_metric",
        "keywords_zh.required",
        "keywords_zh.min_count",
        "keywords_zh.max_count",
        "keywords_zh.separator",
        "keywords_zh.require_after_role",
        "keywords_zh.match_other_language_count",
        "keywords_zh.max_item_chars",
        "keywords_zh.item_length_metric",
        "keywords_en.required",
        "keywords_en.min_count",
        "keywords_en.max_count",
        "keywords_en.separator",
        "keywords_en.require_after_role",
        "keywords_en.match_other_language_count",
        "keywords_en.max_item_chars",
        "keywords_en.item_length_metric",
        "acknowledgments.max_chars",
        "abstract_zh_max_chars_by_degree.*",
        "require_zh_abstract_for_english_thesis",
        "require_zh_keywords_for_english_thesis",
        "required_roles",
        "ordered_roles",
        "ordered_role_groups",
        "toc_depth",
        "required_sections",
        "institution",
        "fields",
        "before_role",
        "missing_value_policy",
        "missing_value_placeholder",
        "layout_id",
        "non_public_administration.*",
        "items",
        "items.*",
        "source_region",
        "public_policy"
      ],
      "disposition": "supported"
    }
  ]
}
