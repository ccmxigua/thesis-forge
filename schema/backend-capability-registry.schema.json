{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/thesis-latex2docx/backend-capability-registry.schema.json",
  "title": "Formatting backend capability registry",
  "type": "object",
  "required": ["schema_version", "backend", "capabilities"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "backend": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role_pattern", "property_patterns", "disposition"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
          "role_pattern": {"type": "string", "minLength": 1},
          "property_patterns": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "disposition": {"enum": ["supported", "unknown", "unsupported"]},
          "requires_source_inventory": {
            "type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}
          },
          "requires_template_profile": {"type": "boolean"},
          "message": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
