{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/thesis/cover-contract.schema.json",
  "title": "Executable thesis cover contract",
  "type": "object",
  "required": ["schema_version", "institution", "before_role", "metadata_status", "missing_value_policy", "missing_value_placeholder", "fields"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "institution": {"type": "string", "minLength": 1},
    "before_role": {"const": "document_start"},
    "metadata_status": {"enum": ["trusted", "pending"]},
    "missing_value_policy": {"const": "placeholder"},
    "missing_value_placeholder": {"type": "string", "minLength": 1},
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "order", "required", "value", "value_kind", "source", "style_role"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 1},
          "required": {"type": "boolean"},
          "value": {"type": "string"},
          "value_kind": {"enum": ["trusted", "placeholder", "omitted"]},
          "source": {"type": "string", "minLength": 1},
          "style_role": {"enum": ["title_zh", "title_en", "cover_field_value"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
