{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Current-session status projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding",
    "next_action",
    "blocked_reasons",
    "internal_review",
    "native_checks",
    "word_release",
    "budgets",
    "submission_ready",
    "provider_model_verified",
    "independent_review_verified"
  ],
  "properties": {
    "schema_version": {
      "const": "thesis-session-status/v1"
    },
    "binding": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "run_id",
        "requirements_sha256",
        "input_sha256",
        "code_sha256",
        "candidate_sha256"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "requirements_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "code_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "next_action": {
      "enum": [
        "blocked",
        "semantic_response",
        "merge_response",
        "generate_candidate",
        "independent_review",
        "native_acceptance",
        "complete_scoped"
      ]
    },
    "blocked_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "internal_review": {
      "type": "object"
    },
    "native_checks": {
      "type": "object"
    },
    "word_release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "not_verified"
        }
      }
    },
    "budgets": {
      "type": [
        "object",
        "null"
      ]
    },
    "submission_ready": {
      "const": false
    },
    "provider_model_verified": {
      "const": false
    },
    "independent_review_verified": {
      "const": false
    },
    "semantic_task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_dir",
        "missing_responses"
      ],
      "properties": {
        "review_dir": {
          "type": "string"
        },
        "missing_responses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "toc": {
      "type": "object"
    }
  }
}
