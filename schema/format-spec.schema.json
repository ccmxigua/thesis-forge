      "type": "object",
      "required": [
        "schema_version",
        "degree_level",
        "writing_language"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "degree_level": {
          "enum": [
            "master",
            "doctor",
            null
          ]
        },
        "degree_category": {
          "enum": [
            "academic",
            "professional"
          ]
        },
        "writing_language": {
          "enum": [
            "zh",
            "en",
            "other",
            null
          ]
        },
        "security_level": {
          "enum": [
            "public",
            "restricted",
            "classified"
          ]
        },
        "metadata_status": {
          "enum": [
            "complete",
            "pending"
          ]
        },
        "pending_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pending_metadata": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pendingMetadata"
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "has_appendices": {
          "type": "boolean"
        },
        "has_figure_list": {
          "type": "boolean"
        },
        "has_table_list": {
          "type": "boolean"
        },
        "has_symbol_list": {
          "type": "boolean"
        },
        "co_supervisor_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "student_id": {
          "type": "string"
        },
        "completion_date": {
          "type": "string",
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12]\\d|3[01]))?$"
        },
        "cover_metadata": {
          "$ref": "#/$defs/coverMetadata"
        }
      },
      "additionalProperties": false
    },
    "coverField": {
      "type": "object",
      "required": [
        "id",
        "label",
        "value_from",
        "display_policy",
        "order"
      ],
      "properties": {
        "id": {
          "enum": [
            "classification_number",
            "unit_code",
            "title_zh",
            "title_en",
            "subtitle_zh",
            "subtitle_en",
            "author_name",
            "student_id",
            "college_name",
            "degree_discipline",
            "professional_degree_type",
            "program_name",
            "field_name",
            "research_direction",
            "supervisor_name",
            "co_supervisors",
            "completion_date",
            "security_marking",
            "embargo_until"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value_from": {
          "enum": [
            "thesis_profile.cover_metadata.classification_number",
            "thesis_profile.cover_metadata.unit_code",
            "thesis_profile.cover_metadata.title_zh",
            "thesis_profile.cover_metadata.title_en",
            "thesis_profile.cover_metadata.subtitle_zh",
            "thesis_profile.cover_metadata.subtitle_en",
            "thesis_profile.cover_metadata.author_name",
            "thesis_profile.cover_metadata.student_id",
            "thesis_profile.cover_metadata.college_name",
            "thesis_profile.cover_metadata.degree_discipline",
            "thesis_profile.cover_metadata.professional_degree_type",
            "thesis_profile.cover_metadata.program_name",
            "thesis_profile.cover_metadata.field_name",
            "thesis_profile.cover_metadata.research_direction",
            "thesis_profile.cover_metadata.supervisor_name",
            "thesis_profile.cover_metadata.co_supervisors",
            "thesis_profile.cover_metadata.completion_date",
            "thesis_profile.cover_metadata.security_marking",
            "thesis_profile.cover_metadata.embargo_until"
          ]
        },
        "display_policy": {
          "enum": [
            "required",
            "if_present"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "coverSpec": {
      "type": "object",
      "required": [
        "institution",
        "fields"
      ],
      "properties": {
        "institution": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/coverField"
          }
        },
        "before_role": {
          "enum": [
            "document_start",
            "abstract_title_zh"
          ],
          "description": "Compatibility input: the cover compiler normalizes either legacy abstract_title_zh or document_start to a document-start anchor."
        },
        "missing_value_policy": {
          "const": "placeholder",
          "description": "Generate the required cover field structure even when trusted instance metadata is unavailable."
        },
        "missing_value_placeholder": {
          "type": "string",
          "minLength": 1,
          "description": "Neutral text used for a required cover value that has not been supplied; defaults to two em dashes."
        },
        "layout_id": {
          "enum": ["linear", "official_template_regions"],
          "description": "Cover execution mode. linear is the generic paragraph fallback. official_template_regions requires a verified official DOCX resource and fixed-region assembly; core code must not redraw a school's cover from guessed geometry."
        }
      },
      "additionalProperties": false
    },
    "signaturePlaceholder": {
      "type": "object",
      "required": [
        "role",
        "label",
        "attestation_scope"
      ],
      "properties": {
        "role": {
          "enum": [
            "author",
            "supervisor",
            "date"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "attestation_scope": {
          "const": "placeholder_presence_only"
        }
      },
      "additionalProperties": false
    },
    "declarationItem": {
      "type": "object",
      "required": [
        "id",
        "signature_placeholders"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "heading": {
          "type": "string",
          "minLength": 1,
          "description": "Exact heading copied from the current source requirements."
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "description": "Compatibility form for one exact source paragraph."
        },
        "body_parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "signature_placeholders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signaturePlaceholder"
          }
        }
      },
      "additionalProperties": false
    },
    "declarationsSpec": {
      "type": "object",
      "required": [
        "before_role",
        "items"
      ],
      "properties": {
        "before_role": {
          "enum": [
            "document_start",
            "abstract_title_zh"
          ],
          "description": "Declarations may be inserted only at a verified document-start or Chinese-abstract anchor. Other roles are not deterministic insertion anchors."
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/declarationItem"
          }
        }
      },
      "additionalProperties": false
    },
    "resourceEntry": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "version",
        "heading",
        "body_parts",
        "sha256",
        "source_evidence_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "fixed_text"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "body_parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "resourceRegistry": {
      "type": "object",
      "required": [
        "schema_version",
        "run_id",
        "items"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/resourceEntry"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
