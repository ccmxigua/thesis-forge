{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/thesis-latex2docx/header-scope-plan.schema.json",
  "title": "Source-bound Header Scope Plan",
  "type": "object",
  "required": ["schema_version", "valid", "scoped", "source_sha256", "format_spec_sha256", "scope_rules", "sections", "findings"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "valid": {"type": "boolean"},
    "scoped": {"type": "boolean"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "format_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scope_rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
    "sections": {"type": "array", "items": {"$ref": "#/$defs/section"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
  },
  "additionalProperties": false,
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["scope", "selector", "content_mode", "header_content", "requirement_ids", "clause_ids", "evidence_ids"],
      "properties": {
        "scope": {"enum": ["toc", "chapter", "appendix", "source_heading"]},
        "selector": {
          "type": "object", "required": ["kind"],
          "properties": {"kind": {"enum": ["toc_heading", "chapter_heading_1", "appendix_heading_1", "source_heading_1"]}},
          "additionalProperties": false
        },
        "content_mode": {"enum": ["fixed", "preserve_source"]},
        "header_content": {
          "type": "object",
          "properties": {"left_text": {"type": "string"}, "right_field": {"enum": ["styleref_heading_1"]}},
          "additionalProperties": false
        },
        "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "clause_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "anchor": {
      "type": "object",
      "required": ["kind", "paragraph_index", "style", "text", "text_sha256"],
      "properties": {
        "kind": {"enum": ["toc_heading", "heading_1"]},
        "paragraph_index": {"type": "integer", "minimum": 0},
        "style": {"type": "string"},
        "text": {"type": "string"},
        "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "variant": {
      "type": "object",
      "required": ["active", "content_mode", "header_content", "expected_text", "source_instructions", "source_linked_to_previous"],
      "properties": {
        "active": {"type": "boolean"},
        "content_mode": {"enum": ["fixed", "preserve_source"]},
        "header_content": {
          "type": "object",
          "properties": {
            "left_text": {"type": "string"},
            "right_field": {"enum": ["styleref_heading_1"]}
          },
          "additionalProperties": false
        },
        "expected_text": {"type": "string"},
        "source_instructions": {"type": "array", "items": {"type": "string"}},
        "source_linked_to_previous": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": ["section_index", "source_section_index", "scope", "source_anchor", "content_mode", "header_content", "requirement_ids", "clause_ids", "evidence_ids", "source_default_header_sha256", "variants"],
      "properties": {
        "section_index": {"type": "integer", "minimum": 1},
        "source_section_index": {"type": "integer", "minimum": 1},
        "scope": {"enum": ["unscoped", "toc", "chapter", "appendix", "source_heading", "unresolved"]},
        "source_anchor": {"anyOf": [{"$ref": "#/$defs/anchor"}, {"type": "null"}]},
        "content_mode": {"enum": ["fixed", "preserve_source"]},
        "header_content": {
          "anyOf": [
            {"type": "object", "properties": {"left_text": {"type": "string"}, "right_field": {"enum": ["styleref_heading_1"]}}, "additionalProperties": false},
            {"type": "null"}
          ]
        },
        "requirement_ids": {"type": "array", "items": {"type": "string"}},
        "clause_ids": {"type": "array", "items": {"type": "string"}},
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "source_default_header_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "variants": {
          "type": "object",
          "required": ["default", "first", "even"],
          "properties": {
            "default": {"$ref": "#/$defs/variant"},
            "first": {"$ref": "#/$defs/variant"},
            "even": {"$ref": "#/$defs/variant"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "severity": {"enum": ["error", "warning", "info"]},
        "message": {"type": "string", "minLength": 1},
        "section_index": {"type": "integer", "minimum": 1},
        "scope": {"type": "string"},
        "requirement_id": {"type": "string"},
        "evidence": {}
      },
      "additionalProperties": false
    }
  }
}
