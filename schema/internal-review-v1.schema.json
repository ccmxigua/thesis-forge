{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "role",
    "binding",
    "artifact_manifest_sha256",
    "reviewer_task_id",
    "verdict",
    "findings",
    "read_artifacts",
    "result_text",
    "source_kind"
  ],
  "properties": {
    "schema_version": {
      "const": "thesis-internal-review/v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "source_format",
        "visual"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "requirements_sha256",
        "input_sha256",
        "code_sha256",
        "candidate_sha256"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "requirements_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "code_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "artifact_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewer_task_id": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": [
        "PASS",
        "HOLD"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "read_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "method"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "method": {
            "enum": [
              "file_read",
              "image_view"
            ]
          }
        }
      }
    },
    "result_text": {
      "type": "string",
      "minLength": 1
    },
    "source_kind": {
      "enum": [
        "reviewer_report",
        "fixture"
      ]
    }
  }
}
