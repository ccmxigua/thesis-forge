{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "operation_id",
    "app",
    "input_binding",
    "native_object_url",
    "native_version",
    "observed_at",
    "upload_status",
    "checks",
    "save_close_reopen",
    "evidence_refs",
    "edited_online",
    "exported_bytes_binding"
  ],
  "properties": {
    "schema_version": {
      "const": "thesis-native-acceptance/v1"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "app": {
      "const": "wps"
    },
    "input_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "requirements_sha256",
        "input_sha256",
        "code_sha256",
        "candidate_sha256"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "requirements_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "code_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "native_object_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "native_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed_at": {
      "type": "string",
      "minLength": 1
    },
    "upload_status": {
      "enum": [
        "confirmed",
        "unknown",
        "not_uploaded"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "outcome",
          "scope",
          "evidence_refs"
        ],
        "properties": {
          "name": {
            "enum": [
              "toc_links",
              "page_number_sequence",
              "heading_keep_next",
              "embedded_objects",
              "font_sample"
            ]
          },
          "outcome": {
            "enum": [
              "pass",
              "fail",
              "not_checked",
              "not_applicable"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "save_close_reopen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "saved",
        "closed",
        "reopened",
        "reopened_url",
        "reopened_version"
      ],
      "properties": {
        "saved": {
          "type": "boolean"
        },
        "closed": {
          "type": "boolean"
        },
        "reopened": {
          "type": "boolean"
        },
        "reopened_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "reopened_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "edited_online": {
      "type": "boolean"
    },
    "exported_bytes_binding": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "native_object_url",
            "native_version",
            "evidence_ref"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "native_object_url": {
              "type": "string",
              "minLength": 1
            },
            "native_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidence_ref": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
