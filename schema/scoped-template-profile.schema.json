{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/thesis-latex2docx/scoped-template-profile.schema.json",
  "title": "Explicit non-release source-bound template scopes",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "input_sha256",
    "authority",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority": {
      "const": "caller_declared"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "selector",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "thesis_subtitle_zh",
              "thesis_subtitle_en",
              "keywords_zh",
              "keywords_en",
              "header",
              "figure_caption",
              "table_caption",
              "bibliography_entry",
              "appendix_body",
              "heading_appendix",
              "heading_publications",
              "heading_acknowledgments",
              "bibliography_heading",
              "abstract_title_zh",
              "abstract_title_en",
              "heading_1",
              "heading_2",
              "heading_3",
              "heading_4",
              "heading_5",
              "heading_6",
              "heading_7",
              "heading_8",
              "heading_9"
            ]
          },
          "selector": {
            "type": "object",
            "required": [
              "text_sha256"
            ],
            "properties": {
              "text_sha256": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 4,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                ]
              },
              "source_style": {
                "type": "string",
                "minLength": 1
              },
              "region": {
                "type": "object",
                "required": [
                  "after",
                  "before"
                ],
                "properties": {
                  "after": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "before": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "font": {
            "$ref": "https://example.local/thesis-latex2docx/format-spec.schema.json#/$defs/fontSpec"
          },
          "paragraph": {
            "$ref": "https://example.local/thesis-latex2docx/format-spec.schema.json#/$defs/paragraphSpec"
          },
          "display_prefix": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[\\s\\S]{0,8}$"
          },
          "keyword": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[\\s\\S]{0,80}$"
              },
              "label_font": {
                "$ref": "https://example.local/thesis-latex2docx/format-spec.schema.json#/$defs/fontSpec"
              },
              "value_font": {
                "$ref": "https://example.local/thesis-latex2docx/format-spec.schema.json#/$defs/fontSpec"
              }
            },
            "additionalProperties": false
          },
          "terminal": {
            "type": "object",
            "required": [
              "accepted",
              "value"
            ],
            "properties": {
              "accepted": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[\\s\\S]{0,1}$"
                }
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[\\s\\S]{0,1}$"
              }
            },
            "additionalProperties": false
          },
          "spacer": {
            "type": "object",
            "required": [
              "count",
              "paragraph"
            ],
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "paragraph": {
                "$ref": "https://example.local/thesis-latex2docx/format-spec.schema.json#/$defs/paragraphSpec"
              }
            },
            "additionalProperties": false
          },
          "header": {
            "type": "object",
            "required": [
              "side",
              "expected_text_sha256"
            ],
            "properties": {
              "side": {
                "enum": [
                  "default",
                  "even",
                  "first"
                ]
              },
              "expected_text_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "synchronize_heading": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "table": {
            "type": "object",
            "required": [
              "top_border_pt",
              "header_border_pt",
              "bottom_border_pt",
              "style"
            ],
            "properties": {
              "top_border_pt": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 12
              },
              "header_border_pt": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 12
              },
              "bottom_border_pt": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 12
              },
              "style": {
                "const": "three_line"
              },
              "color": {
                "type": "string",
                "pattern": "^(?:[0-9A-Fa-f]{6}|auto)$"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "repair_toc_navigation": {
      "type": "boolean"
    },
    "figure_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "caption",
          "reference_label"
        ],
        "properties": {
          "caption": {
            "type": "object",
            "required": [
              "text_sha256"
            ],
            "properties": {
              "text_sha256": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 4,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                ]
              },
              "source_style": {
                "type": "string",
                "minLength": 1
              },
              "region": {
                "type": "object",
                "required": [
                  "after",
                  "before"
                ],
                "properties": {
                  "after": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "before": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "reference_label": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
