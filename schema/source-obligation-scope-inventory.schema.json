{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/thesis-forge/source-obligation-scope-inventory.schema.json",
  "title": "Explicit, source-bound object scope inventory",
  "type": "object",
  "required": ["schema_version", "policy", "binding", "inventory_complete", "scopes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "policy": {"const": "explicit_source_scope_inventory_v1"},
    "binding": {
      "type": "object",
      "required": ["run_id", "case_id", "source_sha256", "format_spec_sha256"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "case_id": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "format_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "inventory_complete": {"type": "boolean"},
    "review_attestation": {
      "type": "object",
      "required": ["reviewer_id", "method", "reviewed_source_sha256"],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1},
        "method": {"const": "human_source_first_scope_review"},
        "reviewed_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reviewed_at_utc": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "scopes": {
      "type": "array",
      "items": {"$ref": "#/$defs/scope"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"inventory_complete": {"const": true}}, "required": ["inventory_complete"]},
      "then": {"required": ["review_attestation"]}
    }
  ],
  "$defs": {
    "sourceBinding": {
      "type": "object",
      "required": ["source_sha256", "clause_id", "source_span_sha256", "evidence_ids"],
      "properties": {
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "clause_id": {"type": "string", "minLength": 1},
        "source_span_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": [
        "scope_id", "source_binding", "object_ref", "condition", "inventory_complete",
        "expected_atom_ids", "atoms", "importance", "review_priority"
      ],
      "properties": {
        "scope_id": {"type": "string", "pattern": "^OS-[0-9a-f]{32}$"},
        "source_binding": {"$ref": "#/$defs/sourceBinding"},
        "object_ref": {"type": "string", "minLength": 1},
        "condition": {"type": "string", "minLength": 1},
        "inventory_complete": {"type": "boolean"},
        "applicability_evidence": {
          "type": "object",
          "required": ["source_sha256", "clause_id", "quote", "evidence_ids"],
          "properties": {
            "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "clause_id": {"type": "string", "minLength": 1},
            "quote": {"type": "string", "minLength": 1},
            "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          },
          "additionalProperties": false
        },
        "expected_atom_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^EU-[0-9a-f]{32}$"}
        },
        "atoms": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["evaluation_unit_id", "evidence_receipt_ids"],
            "properties": {
              "evaluation_unit_id": {"type": "string", "pattern": "^EU-[0-9a-f]{32}$"},
              "evidence_receipt_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
            },
            "additionalProperties": false
          }
        },
        "importance": {"const": "not_assessed"},
        "review_priority": {
          "type": "object",
          "required": ["effect"],
          "properties": {
            "effect": {"const": "sort_only_no_compliance_or_release_effect"},
            "rank": {"type": ["integer", "null"], "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
