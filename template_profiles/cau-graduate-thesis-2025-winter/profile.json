{
  "schema_version": "1.0",
  "profile_id": "cau-graduate-thesis-2025-winter",
  "title": "中国农业大学研究生学位论文模板（2025冬）",
  "authority": {
    "organization": "中国农业大学",
    "source_url": "https://cab.cau.edu.cn/art/2026/1/28/art_48176_1098163.html",
    "effective_version": "2025-winter",
    "published_date": "2026-01-28"
  },
  "resources": [
    {
      "id": "official_word_template",
      "path": "resources/official-template.docx",
      "sha256": "7f27268b043e1f2538aad848a18182c0509e6951fd863d040383e812b8307fdf",
      "kind": "official_docx"
    },
    {
      "id": "official_format_rules",
      "path": "resources/rules.pdf",
      "sha256": "fcfcd354c15e7a0109d6f80460ef4d6787fc0274c4fc1dcc493047c81baaa5e2",
      "kind": "rules_pdf"
    },
    {
      "id": "official_latex_reference",
      "path": "resources/reference.pdf",
      "sha256": "eae6be739794145965cb9615cd30949a09f43535daaa9f0c7fddd7fd1f9931cc",
      "kind": "reference_pdf"
    }
